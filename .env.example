GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Agent HTTP API
AGENT_API_SECRET=change-me-shared-with-nextjs-server
CORS_ORIGINS=http://localhost:3000
# Production: add your Vercel URL, e.g. https://mira-git-main-nabighasafdar-gmailcoms-projects.vercel.app

# Supabase — for loading profile LLM keys, wallet hints, bookmarks
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

MIRA_WORKFLOW_OUTPUT_DIR=

# Visible Chromium window (watch robot browser; hold Space in Mira tab for voice)
MIRA_HEADLESS=false
# Allow extra time for Chromium to start on macOS (seconds)
TIMEOUT_BrowserStartEvent=90
TIMEOUT_BrowserLaunchEvent=90

# Compute LLM dollar cost per job (required for PAYG billing in production)
BROWSER_USE_CALCULATE_COST=true

# Local only: multiply LLM cost on job done (match Mira BILLING_COST_MULTIPLIER; use 1 in production)
MIRA_BILLING_COST_MULTIPLIER=1
