# Production .env for AWS EC2 (or Render Docker)
# Copy to .env on the server: cp .env.production.example .env
# Use the SAME AGENT_API_SECRET on Vercel.

AGENT_API_SECRET=change-me-shared-with-vercel
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Supabase — service role only (never expose to browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated origins; include your Vercel production URL
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# Required in Docker / EC2 (no display server)
MIRA_HEADLESS=true
MIRA_PERSISTENT_PROFILES=true
# Use a persistent volume on EC2 (not /tmp) so logins survive container restarts
MIRA_BROWSER_PROFILE_DIR=/tmp/mira_browser_profiles
MIRA_BROWSER_IDLE_SECONDS=1800

MIRA_WORKFLOW_OUTPUT_DIR=
